# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave unset locally to use SQLite. Example: postgres://user:pass@db:5432/dashboard
DATABASE_URL=
# Initial app timezone (editable later in Settings)
APP_TIMEZONE=America/Toronto

# Phase 3+
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
# Phase 4+
ANTHROPIC_API_KEY=
