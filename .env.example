# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave unset locally to use SQLite. docker-compose sets it for production.
DATABASE_URL=
# Initial app timezone (editable later in Settings)
APP_TIMEZONE=America/Toronto

# Telegram bot: token from @BotFather, and your own numeric user ID
# (message @userinfobot to find it). Only this user can talk to the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Production (docker compose). Use letters and digits only in the password.
DOMAIN=
POSTGRES_PASSWORD=

# Phase 4+
ANTHROPIC_API_KEY=
