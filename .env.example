# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave unset locally to use SQLite. docker-compose sets it for production.
DATABASE_URL=
# Initial app timezone (editable later in Settings)
APP_TIMEZONE=America/Toronto

# Telegram bot: the token and username @BotFather gives you. Each person
# connects their own Telegram in Settings → Telegram; the bot ignores everyone
# else. The bot process needs the token; the web app needs the username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Production on Railway: set SECRET_KEY, DEBUG=false, DATABASE_URL=${{Postgres.DATABASE_URL}}
# and PORT=8080 in the service's Variables (see README). DOMAIN defaults to
# Railway's generated domain.
#
# Production (docker compose). Use letters and digits only in the password.
DOMAIN=
POSTGRES_PASSWORD=
# Nightly database dumps go to ./backups on the server.
# BACKUP_KEEP_DAYS=14
# BACKUP_HOUR_UTC=8

# Claude API key: lets the palette and the bot understand plain sentences.
# Without it, only the built-in quick-log grammar is used.
ANTHROPIC_API_KEY=
# PARSER_MODEL=claude-haiku-5-5
# INSIGHTS_MODEL=claude-sonnet-5-5
